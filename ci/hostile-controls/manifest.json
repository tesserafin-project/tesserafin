{
  "$comment": "#153-LTV-R1. The hostile controls that defend the Live TV stack, versioned so anyone with a clone can replay them. LTV-R0 finding 4: the S0 and S1 rosters existed only as untracked python harnesses that hardcoded one worktree path and mutated it in place.",
  "restoration": {
    "rule": "byte-identical",
    "measurement": "git write-tree is compared against the baseline after every control; any run whose tree does not match is downgraded to ERROR. The index is staged FOR REAL - `git add -A -n` is a dry run and would make the comparison vacuous, which is a defect the S1 harness shipped with."
  },
  "isolation": {
    "rule": "temporary-worktree",
    "detail": "The runner creates its own git worktree from the commit under test and never touches the user's worktree. Controls run serially, in the foreground: two concurrent background roster runs corrupted the S1 roster once already."
  },
  "grades": {
    "PASS": "the gate was green and the control expected green",
    "RED": "the gate failed, on the property the control names",
    "INERT": "the mutation applied but the gate stayed green - the property is unprotected",
    "ERROR": "the mutation did not apply, did not build, or the tree was not restored",
    "HUNG": "the gate exceeded its timeout"
  },
