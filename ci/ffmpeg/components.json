  "excluded": {
    "fdk-aac-stripped": "libfdk_aac is classified nonfree by FFmpeg; FFmpeg's native AAC encoder covers the requirement",
    "libzvbi": "GPL-2.0-or-later teletext decoding; not referenced by any Tesserafin capability",
    "libsrt": "SRT transport; the 'srt' entry in _requiredEncoders is the SubRip SUBTITLE encoder, which is native",
    "libbluray": "Tesserafin parses BDMV with its own managed BdInfo; no libbluray call site",
    "libopenmpt": "tracker-module playback; no Tesserafin call site",
    "chromaprint": "audio fingerprinting; no Tesserafin call site",
    "libtheora": "no Tesserafin call site",
    "libwebp": "no Tesserafin encoder/decoder requirement",
    "libudfread": "only reachable through libbluray",
    "fftw3f": "only reachable through chromaprint",
    "gmp": "only reachable through the excluded components",
    "libxml2": "DASH/IMF demuxing; not a Tesserafin capability requirement",
    "libne10": "superseded by compiler intrinsics on aarch64",
    "rkmpp": "Rockchip SBC codepath; outside the declared linux-x64/linux-arm64 support matrix",
    "rkrga": "Rockchip SBC codepath; outside the declared support matrix",
    "mingw / dxva / schannel / mfx / x11 / xorg-macros": "Windows or X11 targets; Tesserafin ships headless Linux",
    "libplacebo + vulkan-headers + shaderc + glslang + SPIRV-Tools + SPIRV-Headers": "DEFERRED, NOT UNNEEDED. EncoderValidator._requiredFilters names 'libplacebo', so this is a real capability gap against the container image: Vulkan tone-mapping is unavailable and the server falls back to tonemap_vaapi / tonemap_opencl / the software tonemapx path. It is deferred from build revision 7.1.4-tesserafin.1 because the shader-toolchain subtree is the largest single source-closure and reproducibility risk in the component set. Tracked as a named gap in docs/distribution/F0-ffmpeg-runtime.md, not silently dropped."
