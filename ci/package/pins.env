# Pinned build inputs for the native Linux server packages (issue #225 / [L0]).
#
# EVERY pin that already exists in the Dockerfile is read FROM the Dockerfile by
# ci/package/lib.sh — the web assets image digest, the paired web commit and the
# jellyfin-ffmpeg version all have exactly one definition, and lib.sh fails
# closed if this file disagrees with it.
#
# What lives here is only what the container path does not pin, because the
# container installs the Ubuntu-noble .deb and the packages install the portable
# build from the SAME upstream release. See docs/distribution/L0-linux-packages.md
# section "FFmpeg boundary" for why the asset differs and what was measured to
# show the capability does not.

# Must equal FFMPEG_VERSION in the Dockerfile. Asserted, not assumed.
FFMPEG_VERSION=7.1.4-3

# github.com/jellyfin/jellyfin-ffmpeg release v${FFMPEG_VERSION}:
#   jellyfin-ffmpeg_${FFMPEG_VERSION}_portable_linux64-gpl.tar.xz
#   jellyfin-ffmpeg_${FFMPEG_VERSION}_portable_linuxarm64-gpl.tar.xz
FFMPEG_PORTABLE_SHA256_LINUX_X64=cab9ff40a47e4232d231e4eb7e4e85fabfeec56c6905266bc94291fc0881f83f
FFMPEG_PORTABLE_SHA256_LINUX_ARM64=77e4b5d044ab73e1f26c9aadaa5d6014d1782500bf2c29afb3ab81f5bea98b1f

# SHA-256 of the normalised tar of the bundled Tesserafin Web payload extracted
# from the pinned assets image, with modes normalised and hashed at the epoch the
# web build recorded for itself. Recomputed on every build and compared against this value: a provenance
# drift fails the build instead of shipping.
WEB_PAYLOAD_SHA256=4148c4bc6e0c7c2d6b35ed9992e874a06dcc11d2b6d9e0aad06719e36567be4f

# The rpmbuild toolchain, pinned by immutable digest so the packaging tool is a
# build input like any other. Fedora 42 carries rpm 4.20, which honours
# SOURCE_DATE_EPOCH for the build time and the payload mtime clamp.
RPM_BUILDER_IMAGE=fedora@sha256:99e203b80b1c3d8f7e161ec10a68fd02b081ef83a3963553e513c82846b97814

# The base image carries no rpmbuild, so build-rpm.sh layers rpm-build on top.
# The resulting tool version is asserted rather than accepted: an rpm upgrade in
# the Fedora repositories can change header encoding, and a silent toolchain
# change is exactly the kind of drift a reproducibility gate must not absorb.
RPM_BUILDER_RPM_VERSION=4.20.1

# Lifecycle acceptance environments, pinned by multi-architecture INDEX digest so
# the amd64 and arm64 jobs each resolve the native image of the same release.
# Neither base image ships systemd, so the lifecycle scripts layer it (plus the
# test tooling: curl, python3, ps) on top of the pinned base before booting it as
# PID 1. The layered image is an acceptance ENVIRONMENT, never a build input, and
# never contributes to an artifact.
DEB_ACCEPT_IMAGE=ubuntu@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
RPM_ACCEPT_IMAGE=rockylinux/rockylinux@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f
ARCHIVE_ACCEPT_IMAGE=debian@sha256:813017f3d62be4b5891a7acca6a01bdcd4b8513daa81b1ab99d3a50385b26931
