# Pinned build inputs for the native Linux server packages (issue #225 / [L0]).
#
# EVERY pin that already exists somewhere else is read FROM that place by
# ci/package/lib.sh, and lib.sh fails closed if this file disagrees with it:
#
#   * the web assets image digest and the paired web commit -> the Dockerfile;
#   * the FFmpeg runtime revision and its upstream commit   -> ci/ffmpeg/components.json.
#
# What lives here is only what neither of those declares.
#
# The packages do NOT download a prebuilt FFmpeg. They build the accepted
# Tesserafin FFmpeg runtime (F0 / #229) from the pinned sources and scripts on
# master, with ci/package/ffmpeg-runtime.sh as a thin adapter over ci/ffmpeg/**.
# There is no release asset, no portable tarball and no checksum for one, because
# there is nothing to download. See docs/distribution/L0-linux-packages.md,
# "FFmpeg runtime".

# --- The accepted F0 runtime -------------------------------------------------
#
# Must equal buildRevision / ffmpeg.commit in ci/ffmpeg/components.json.
# Asserted, not assumed: a package built against a different runtime revision
# than the one that was accepted must fail rather than ship.
F0_RUNTIME_REVISION=7.1.4-tesserafin.1
F0_UPSTREAM_COMMIT=d4590e12452f94d40e413caecb34b08de608353b

# The runtime as a whole is GPL-3.0-or-later: FFmpeg is configured with
# --enable-gpl and --enable-version3. The SERVER remains GPL-2.0-or-later. The
# two boundaries are separate and are recorded separately everywhere.
F0_RUNTIME_LICENSE=GPL-3.0-or-later

# The `git rev-parse HEAD:ci/ffmpeg` tree the accepted digest baseline in
# ci/package/f0-accepted-digests.txt was produced from. While the tree is
# unchanged, a freshly built runtime that does NOT reproduce those digests is
# unexplained drift and fails the package build. When ci/ffmpeg/** legitimately
# changes, the baseline is stale by construction and the comparison is reported
# rather than enforced — a stale oracle must not be able to green a build.
F0_ACCEPTED_CI_TREE=578506afe60bc3ca10b09dd714fad098d1a666f2

# --- The bundled Tesserafin Web payload --------------------------------------
#
# SHA-256 of the normalised tar of the bundled Tesserafin Web payload extracted
# from the pinned assets image, with modes normalised and hashed at the epoch the
# web build recorded for itself. Recomputed on every build and compared against
# this value: a provenance drift fails the build instead of shipping.
WEB_PAYLOAD_SHA256=4148c4bc6e0c7c2d6b35ed9992e874a06dcc11d2b6d9e0aad06719e36567be4f

# --- Packaging toolchain -----------------------------------------------------
#
# The rpmbuild toolchain, pinned by immutable INDEX digest so the packaging tool
# is a build input like any other AND so the arm64 job resolves the native image
# of the same release. Both architectures now build their own RPM on their own
# machine, so a single-architecture digest here would fail the arm64 job after it
# had already spent a quarter of an hour building the FFmpeg runtime.
# Verified: this digest is an index carrying linux/amd64 and linux/arm64.
# Fedora 42 carries rpm 4.20, which honours SOURCE_DATE_EPOCH for the build time
# and the payload mtime clamp.
RPM_BUILDER_IMAGE=fedora@sha256:99e203b80b1c3d8f7e161ec10a68fd02b081ef83a3963553e513c82846b97814

# The base image carries no rpmbuild, so build-rpm.sh layers rpm-build on top.
# The resulting tool version is asserted rather than accepted: an rpm upgrade in
# the Fedora repositories can change header encoding, and a silent toolchain
# change is exactly the kind of drift a reproducibility gate must not absorb.
# Measured on rpm 4.20.1: the SPDX expression in the spec round-trips through
# %{LICENSE} unchanged, which is why the two licence boundaries can be stated in
# one valid expression rather than flattened to the server's.
RPM_BUILDER_RPM_VERSION=4.20.1

# --- Lifecycle acceptance environments ---------------------------------------
#
# Pinned by multi-architecture INDEX digest so the amd64 and arm64 jobs each
# resolve the native image of the same release. Neither base image ships systemd,
# so the lifecycle scripts layer it (plus the test tooling: curl, python3, ps) on
# top of the pinned base before booting it as PID 1. The layered image is an
# acceptance ENVIRONMENT, never a build input, and never contributes to an
# artifact.
DEB_ACCEPT_IMAGE=ubuntu@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
RPM_ACCEPT_IMAGE=rockylinux/rockylinux@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f
ARCHIVE_ACCEPT_IMAGE=debian@sha256:813017f3d62be4b5891a7acca6a01bdcd4b8513daa81b1ab99d3a50385b26931
