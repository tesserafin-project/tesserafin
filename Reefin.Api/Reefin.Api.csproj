  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reefin.Controller\Reefin.Controller.csproj" />
    <ProjectReference Include="..\Reefin.MediaEncoding\Reefin.MediaEncoding.csproj" />
    <ProjectReference Include="..\src\Reefin.MediaEncoding.Hls\Reefin.MediaEncoding.Hls.csproj" />
    <ProjectReference Include="..\src\Reefin.Networking\Reefin.Networking.csproj" />
    <!-- PR112: PlaybackSessionResponse and its mapper reference the stable PR91 decision
         vocabulary, never Reefin.Model.Dlna or the internal PlaybackSession record. -->
    <ProjectReference Include="..\src\Reefin.Playback.Decision\Reefin.Playback.Decision.csproj" />
    <!-- PR112b: the request side now accepts ClientCapabilities/PlaybackConstraints too, so
         PlaybackSessionsController needs the TEMPORARY ReverseDlnaAdapter to translate them back
         into the legacy DeviceProfile/MediaOptions the pipeline still consumes (delete this
         reference alongside the adapter itself once the v2 execution layer lands - PR114a). -->
    <ProjectReference Include="..\src\Reefin.Playback.Dlna\Reefin.Playback.Dlna.csproj" />
    <!-- PR113: PlaybackDiagnosticDetail's Comparison exposes DivergenceClass (and derives from the
         retained DecisionVector), the shadow-mode comparison vocabulary - never the internal
         ShadowDiagnosticRecord's raw PlaybackDecision/DecisionVector/ShadowDivergence types beyond
         what the mapper projects out of them. -->
    <ProjectReference Include="..\src\Reefin.Playback.Shadow\Reefin.Playback.Shadow.csproj" />
  </ItemGroup>

  <!-- Code Analyzers -->
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
    <PackageReference Include="IDisposableAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Reefin.Api.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
