<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Reefin.Playback.Shadow/Reefin.Playback.Shadow.csproj" />
    <ProjectReference Include="../../src/Reefin.Playback.Engine/Reefin.Playback.Engine.csproj" />
    <ProjectReference Include="../../src/Reefin.Playback.Dlna/Reefin.Playback.Dlna.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oracle harness (PR98): reuses the Test Data fixtures from Reefin.Model.Tests
         (StreamBuilderTests' pattern) so the same device profiles / media sources drive both the
         real legacy StreamBuilder and the real v2 PlaybackEngine. -->
    <None Include="..\Reefin.Model.Tests\Test Data\DeviceProfile-Chrome.json" Link="Test Data\DeviceProfile-Chrome.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\DeviceProfile-Firefox.json" Link="Test Data\DeviceProfile-Firefox.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mp4-h264-aac-vtt-2600k.json" Link="Test Data\MediaSourceInfo-mp4-h264-aac-vtt-2600k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mkv-h264-ac3-srt-2600k.json" Link="Test Data\MediaSourceInfo-mkv-h264-ac3-srt-2600k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mp4-h264-ac3-aac-srt-2600k.json" Link="Test Data\MediaSourceInfo-mp4-h264-ac3-aac-srt-2600k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mp4-hevc-aac-srt-15200k.json" Link="Test Data\MediaSourceInfo-mp4-hevc-aac-srt-15200k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- PR104: additional oracle case reusing the same already-vtt (alias-normalized, PR103)
         subtitle-bearing source as the existing direct-play case, paired with a different device
         profile, plus one genuinely new source/profile pair that stays subtitle-free. -->
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mkv-vp9-vorbis-vtt-2600k.json" Link="Test Data\MediaSourceInfo-mkv-vp9-vorbis-vtt-2600k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- PR111b: 3 new mandatory HDR/10-bit oracle cases - H.264 10-bit (High 10 profile), Dolby
         Vision natively supported by the device, and Dolby Vision NOT supported (forcing legacy to
         fall back/transcode the range). WebOS-23 is the new device profile (its hevc CodecProfile
         explicitly allows DOVIWithHDR10 in VideoRangeType, unlike Chrome/Firefox). -->
    <None Include="..\Reefin.Model.Tests\Test Data\DeviceProfile-WebOS-23.json" Link="Test Data\DeviceProfile-WebOS-23.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mp4-h264-hi10p-aac-5000k.json" Link="Test Data\MediaSourceInfo-mp4-h264-hi10p-aac-5000k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Reefin.Model.Tests\Test Data\MediaSourceInfo-mp4-dvhe.08-eac3-15200k.json" Link="Test Data\MediaSourceInfo-mp4-dvhe.08-eac3-15200k.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
