{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reefin/tests/PlaybackCompat/fixture.schema.json",
  "title": "Playback compatibility fixture (v5)",
  "description": "Versioned fixture for the playback-decision compatibility lab (PR93). Input mirrors the PR91 domain objects; 'expected' describes the v2 PlaybackDecision. Legacy projection is computed at run time and compared by category (PR98), never by raw StreamInfo equality. v2 (PR102): 'capabilities' splits into 'decode' (DecodeCapabilities) and 'outputProfiles' (ordered PlaybackOutputProfile list). v2.2 (PR102b): per-codec limits replace global decode limits. v2.3 (PR103): 'expected.output' gains 'totalBitrate'/'videoBitrate'/'audioBitrate'; 'constraints' gains 'subtitleMode'/'preferredSubtitleLanguages'. v5 (PR104): 'input.source' (singular) replaced by 'input.sources' (array, at least one entry) plus optional top-level 'input.requestedMediaSourceId' (moved out of 'context', which now carries only 'mediaKind'); 'expected.output' gains 'protocol' (Http/Hls); this schema is now executed by a parameterized test (JsonSchema.Net) instead of being documentation-only, and every fixture is deserialized with unknown-member rejection - both gates are enforced by tests/Tesserafin.Playback.Engine.Tests, not just this file.",
  "type": "object",
  "required": ["fixtureVersion", "id", "category", "engineVersion", "input", "expected"],
  "additionalProperties": false,
  "properties": {
    "fixtureVersion": { "const": 5 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": {
      "type": "string",
      "enum": [
        "direct-play", "remux", "audio-transcode", "video-codec-incompatible",
        "bitrate-resolution-limit", "hdr-tonemap", "subtitle-burn-in",
        "subtitle-external", "downmix", "live-tv", "alternate-versions", "no-viable-plan",
        "requested-source", "direct-play-mismatch", "per-codec-limit",
        "output-profile-order", "protocol-selection", "subtitle-auto-select",
        "invalid-index", "codec-bitrate-limit", "av1-preferred"
      ]
    },
    "engineVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Must equal PlaybackEngine.EngineVersion; the runner fails the test otherwise (checked at run time, not by this schema, since the schema has no way to know the current engine constant)."
    },
    "description": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["context", "capabilities", "sources", "constraints"],
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object",
          "description": "PR104: carries only 'mediaKind' - the requested source id lives on 'input.requestedMediaSourceId' instead, since it is a top-level input concern, not a request-identity concern.",
          "required": ["mediaKind"],
          "additionalProperties": false,
          "properties": {
            "mediaKind": { "enum": ["Audio", "Video"] }
          }
        },
        "capabilities": {
          "type": "object",
          "description": "ClientCapabilities (PR91 §3.2, split into decode/outputProfiles by PR102). No DLNA DeviceProfile.",
          "additionalProperties": false,
          "properties": {
            "decode": {
              "type": "object",
              "description": "DecodeCapabilities: what the client can read as-is, no server-side transformation.",
              "additionalProperties": false,
              "properties": {
                "directPlayProfiles": {
                  "type": "array",
                  "description": "DecodeProfile list (PR102b): declared container+videoCodec(s)+audioCodec(s) combinations, one entry per legacy DirectPlayProfile, order preserved. Empty containers/videoCodecs/audioCodecs on an entry is a wildcard (matches anything on that axis), same semantics as an empty legacy DirectPlayProfile field. Direct play requires a single entry to accept the exact container+videoCodec+audioCodec(+MediaKind) combination - see docs/pr102b (problem #1).",
                  "items": {
                    "type": "object",
                    "required": ["type"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "enum": ["Audio", "Video"] },
                      "containers": { "type": "array", "items": { "type": "string" } },
                      "videoCodecs": { "type": "array", "items": { "type": "string" } },
                      "audioCodecs": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "videoCodecs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "codec": { "type": "string" },
                      "profiles": { "type": "array", "items": { "type": "string" } },
                      "maxLevel": { "type": ["number", "null"] },
                      "maxBitDepth": { "type": ["integer", "null"] },
                      "videoRangeTypes": { "type": "array", "items": { "type": "string" } },
                      "maxResolution": {
                        "type": ["object", "null"],
                        "description": "Per-codec resolution ceiling (PR102b problem #2) - replaces the old global decode.maxResolution.",
                        "additionalProperties": false,
                        "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } }
                      },
                      "maxBitrate": {
                        "type": ["integer", "null"],
                        "description": "Per-codec video bitrate ceiling (PR102b problem #2) - replaces the old global decode.maxVideoBitrate."
                      }
                    },
                    "required": ["codec"]
                  }
                },
                "audioCodecs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "codec": { "type": "string" },
                      "maxChannels": { "type": ["integer", "null"] },
                      "maxSampleRate": { "type": ["integer", "null"] },
                      "maxBitDepth": { "type": ["integer", "null"] },
                      "maxBitrate": {
                        "type": ["integer", "null"],
                        "description": "Per-codec audio bitrate ceiling (PR102b) - replaces the old global decode.maxAudioBitrate."
                      }
                    },
                    "required": ["codec"]
                  }
                },
                "subtitleDelivery": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "format": { "type": "string" },
                      "method": { "enum": ["Embed", "External", "Burn", "Hls"] }
                    },
                    "required": ["format", "method"]
                  }
                },
                "supportsHls": { "type": "boolean" },
                "supportsDash": { "type": "boolean" }
              }
            },
            "outputProfiles": {
              "type": "array",
              "description": "Ordered PlaybackOutputProfile list (PR102): what the server should produce when it must transcode, index 0 = most preferred. Empty means the client declares no transcoding target; the engine falls back to a named legacy default.",
              "items": {
                "type": "object",
                "required": ["type", "container"],
                "additionalProperties": false,
                "properties": {
                  "type": { "enum": ["Audio", "Video"] },
                  "protocol": { "enum": ["Http", "Hls"] },
                  "container": { "type": "string" },
                  "videoCodecs": { "type": "array", "items": { "type": "string" } },
                  "audioCodecs": { "type": "array", "items": { "type": "string" } },
                  "maxVideoBitrate": { "type": ["integer", "null"] },
                  "maxAudioBitrate": { "type": ["integer", "null"] },
                  "maxAudioChannels": { "type": ["integer", "null"] }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "description": "PR104: replaces the v1-v4 singular 'source' - one or more MediaSourceSnapshot entries (PR91 §3.3), e.g. alternate versions of the same item. When 'requestedMediaSourceId' is absent the engine picks the best viable source in list order (Direct Play > Remux > Transcode); when present, only the source with that id is considered.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mediaSource" }
        },
        "requestedMediaSourceId": {
          "type": ["string", "null"],
          "description": "PR104: the specific source id requested, or absent/null to let the engine choose among 'sources'. Maps to PlaybackRequestContext.MediaSourceId. A value naming no source in 'sources' produces ReasonCode.RequestedSourceNotFound."
        },
        "constraints": {
          "type": "object",
          "description": "PlaybackConstraints (PR91 §3.4).",
          "additionalProperties": false,
          "properties": {
            "allowDirectPlay": { "type": "boolean" },
            "allowDirectStream": { "type": "boolean" },
            "allowTranscoding": { "type": "boolean" },
            "allowVideoStreamCopy": { "type": "boolean" },
            "allowAudioStreamCopy": { "type": "boolean" },
            "maxBitrate": { "type": ["integer", "null"] },
            "maxAudioChannels": { "type": ["integer", "null"] },
            "preferredAudioStreamIndex": { "type": ["integer", "null"] },
            "preferredSubtitleStreamIndex": { "type": ["integer", "null"] },
            "subtitleMode": {
              "enum": ["Default", "Always", "OnlyForced", "None", "Smart"],
              "description": "PR103: how to auto-select a subtitle when preferredSubtitleStreamIndex is absent. Defaults to Default when omitted."
            },
            "preferredSubtitleLanguages": {
              "type": "array",
              "items": { "type": "string" },
              "description": "PR103: preferred subtitle languages in order; empty/omitted is a wildcard (matches any language)."
            },
            "alwaysBurnInSubtitleWhenTranscoding": { "type": "boolean" }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["method", "isViable"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["DirectPlay", "Remux", "Transcode"] },
        "selectedStreams": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video": { "type": ["integer", "null"] },
            "audio": { "type": ["integer", "null"] },
            "subtitle": { "type": ["integer", "null"] }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": { "type": ["string", "null"] },
            "videoCodec": { "type": ["string", "null"] },
            "audioCodec": { "type": ["string", "null"] },
            "resolution": { "type": ["object", "null"] },
            "videoRange": { "type": ["string", "null"] },
            "audioChannels": { "type": ["integer", "null"] },
            "totalBitrate": { "type": ["integer", "null"] },
            "videoBitrate": { "type": ["integer", "null"] },
            "audioBitrate": { "type": ["integer", "null"] },
            "protocol": {
              "enum": ["Http", "Hls"],
              "description": "PR104: OutputSpec.Protocol is non-nullable in the domain (Http is the neutral default); omitting this in a fixture means Http, matching the engine's own default."
            }
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "enum": ["RemuxContainer", "TranscodeVideo", "TranscodeAudio", "CopyVideo",
                     "CopyAudio", "Downmix", "Tonemap", "BurnInSubtitle", "ExtractSubtitle"]
          }
        },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "isViable": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "mediaSource": {
      "type": "object",
      "required": ["container"],
      "additionalProperties": false,
      "properties": {
        "mediaSourceId": { "type": ["string", "null"] },
        "container": { "type": "string" },
        "protocol": { "type": "string" },
        "bitrate": { "type": ["integer", "null"] },
        "runTimeTicks": {
          "type": ["integer", "null"],
          "description": "PR104: null represents an unbounded/live source (see the 'live-tv' category) as well as any source of unknown duration - the engine never branches on this field, so no separate IsLive flag was needed."
        },
        "videoStreams": { "type": "array", "items": { "$ref": "#/$defs/videoStream" } },
        "audioStreams": { "type": "array", "items": { "$ref": "#/$defs/audioStream" } },
        "subtitleStreams": { "type": "array", "items": { "$ref": "#/$defs/subtitleStream" } },
        "supportsDirectPlay": { "type": "boolean" },
        "supportsDirectStream": { "type": "boolean" },
        "supportsTranscoding": { "type": "boolean" }
      }
    },
    "videoStream": {
      "type": "object",
      "required": ["index", "codec"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" },
        "codec": { "type": "string" },
        "profile": { "type": ["string", "null"] },
        "level": { "type": ["number", "null"] },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "bitDepth": { "type": ["integer", "null"] },
        "videoRange": { "type": ["string", "null"] },
        "framerate": { "type": ["number", "null"] },
        "bitrate": { "type": ["integer", "null"] },
        "isAnamorphic": { "type": ["boolean", "null"] },
        "isInterlaced": { "type": ["boolean", "null"] }
      }
    },
    "audioStream": {
      "type": "object",
      "required": ["index", "codec"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" },
        "codec": { "type": "string" },
        "channels": { "type": ["integer", "null"] },
        "sampleRate": { "type": ["integer", "null"] },
        "bitDepth": { "type": ["integer", "null"] },
        "bitrate": { "type": ["integer", "null"] },
        "language": { "type": ["string", "null"] },
        "isDefault": { "type": ["boolean", "null"] }
      }
    },
    "subtitleStream": {
      "type": "object",
      "required": ["index", "format"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" },
        "format": { "type": "string" },
        "isExternal": { "type": ["boolean", "null"] },
        "isForced": { "type": ["boolean", "null"] },
        "isDefault": { "type": ["boolean", "null"] },
        "language": { "type": ["string", "null"] }
      }
    }
  }
}
