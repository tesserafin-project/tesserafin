{
  "fixtureVersion": 2,
  "id": "video-codec-incompatible",
  "category": "video-codec-incompatible",
  "engineVersion": 3,
  "description": "AV1 video the client cannot decode, in an accepted MP4 container with accepted AAC audio. Only the video codec fails, so video transcodes (to the client's declared H.264 output profile) and audio is copied; container is unchanged (no remux).",
  "input": {
    "context": { "mediaKind": "Video" },
    "capabilities": {
      "decode": {
        "containers": ["mp4"],
        "videoCodecs": [{ "codec": "h264", "profiles": [], "maxLevel": 62, "maxBitDepth": 10, "videoRangeTypes": ["SDR"] }],
        "audioCodecs": [{ "codec": "aac", "maxChannels": 8 }],
        "subtitleDelivery": [],
        "maxVideoBitrate": 100000000
      },
      "outputProfiles": [
        { "type": "Video", "protocol": "Http", "container": "mp4", "videoCodecs": ["h264"], "audioCodecs": ["aac"] }
      ]
    },
    "source": {
      "mediaSourceId": "src-1",
      "container": "mp4",
      "protocol": "file",
      "bitrate": 12000000,
      "videoStreams": [{ "index": 0, "codec": "av1", "width": 1920, "height": 1080, "bitDepth": 8, "videoRange": "SDR", "bitrate": 10000000 }],
      "audioStreams": [{ "index": 1, "codec": "aac", "channels": 2, "isDefault": true }],
      "subtitleStreams": [],
      "supportsDirectPlay": true,
      "supportsDirectStream": true,
      "supportsTranscoding": true
    },
    "constraints": {
      "allowDirectPlay": true, "allowDirectStream": true, "allowTranscoding": true,
      "allowVideoStreamCopy": true, "allowAudioStreamCopy": true
    }
  },
  "expected": {
    "method": "Transcode",
    "selectedStreams": { "video": 0, "audio": 1, "subtitle": null },
    "output": { "container": "mp4", "videoCodec": "h264", "audioCodec": "aac" },
    "transforms": ["TranscodeVideo", "CopyAudio"],
    "reasonCodes": ["VideoCodecNotSupported", "MethodChosen"],
    "isViable": true
  }
}
