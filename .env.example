# Copy to `.env` and edit. `docker compose` reads it automatically.
# No secrets belong in this file — Tesserafin's admin account is created in the
# browser on first run, not here.

# Path to your media library on the host. Mounted READ-ONLY at /media.
# Examples:
#   Linux/NAS : TESSERAFIN_MEDIA=/mnt/user/media
#   macOS     : TESSERAFIN_MEDIA=/Users/you/Media
# Leave unset to start with an empty ./media folder and add real media later.
#TESSERAFIN_MEDIA=/path/to/your/media

# Pin or override the image. Defaults to the immutable pre-release dev tag in
# docker-compose.yml. Dev tags do NOT auto-update — change this to move versions.
#TESSERAFIN_IMAGE=ghcr.io/tesserafin-project/tesserafin:12.0.0-dev.e22b4e9f3ce4
