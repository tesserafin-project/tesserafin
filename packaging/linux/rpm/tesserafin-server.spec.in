# Tesserafin Server — RPM specification.
#
# This spec never compiles anything. It packages a payload tree that
# ci/package/assemble-payload.sh has already staged and byte-frozen, so that the
# .deb, the .rpm and the .tar.gz for one architecture carry identical bytes.

# --- Reproducibility -------------------------------------------------------
# rpmbuild otherwise stamps the build host and the wall clock into the header.
%global _buildhost                        tesserafin-build
%global use_source_date_epoch_as_buildtime 1
%global source_date_epoch_from_changelog   0
%global clamp_mtime_to_source_date_epoch   1
%global _binary_payload                    w19.zstdio
%global _source_payload                    w19.zstdio
# The payload is prebuilt: no stripping, no debuginfo, no build-id symlinks.
%global __os_install_post                  %{nil}
%global debug_package                      %{nil}
%global _build_id_links                    none

# --- Dependency generation --------------------------------------------------
# The bundled .NET runtime and ffmpeg would otherwise both PROVIDE their private
# sonames (polluting the system view) and REQUIRE sonames that only exist inside
# the payload. Both generators are switched off over the payload and the real
# system requirements are declared explicitly below.
%global __provides_exclude_from ^/usr/(lib|share)/tesserafin/.*$
%global __requires_exclude_from ^/usr/(lib|share)/tesserafin/.*$

Name:           tesserafin-server
Version:        @RPM_VERSION@
Release:        @RPM_RELEASE@
Summary:        Tesserafin media server
License:        GPL-2.0-or-later
URL:            https://github.com/tesserafin-project/tesserafin

# The architecture comes from rpmbuild --target, never from a BuildArch tag.
# Both architectures are built on one x86_64 machine (the payload is prebuilt, so
# nothing is compiled here); a spec that declares a foreign BuildArch makes
# rpmbuild refuse with "No compatible architectures found for build", while
# --target alone cross-produces the package correctly.

Requires:       glibc
Requires:       libstdc++
Requires:       libicu
Requires:       fontconfig
Requires:       dejavu-sans-fonts
Requires:       openssl-libs
Requires(pre):  shadow-utils
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd

%description
Tesserafin is a self-hosted media server. This package installs the server
application, the bundled Tesserafin Web client and a systemd service that runs
it as the unprivileged "tesserafin" user.

The application payload is a self-contained .NET build, so no system .NET
runtime is required. A checksum-pinned jellyfin-ffmpeg build is bundled and is
the only encoder the service uses; it never falls back to an ffmpeg found on
$PATH.

Server commit: @VCS_REF@
Bundled Tesserafin Web commit: @WEB_VCS_REF@

%prep
# Nothing to unpack: %%install copies the pre-staged payload tree.

%build
# Nothing to build.

%install
cp -a %{_stagedir}/. %{buildroot}/

%pre
getent group tesserafin >/dev/null || groupadd --system tesserafin
getent passwd tesserafin >/dev/null || \
    useradd --system --gid tesserafin --no-create-home \
            --home-dir /var/lib/tesserafin --shell /sbin/nologin \
            --comment "Tesserafin Server" tesserafin
exit 0

%post
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    if [ "$1" -eq 1 ]; then
        # First install: enable, but do not start.
        systemctl enable tesserafin.service >/dev/null 2>&1 || :
    elif systemctl is-active --quiet tesserafin.service; then
        systemctl restart tesserafin.service >/dev/null 2>&1 || :
    fi
fi
exit 0

%preun
if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
    systemctl stop tesserafin.service >/dev/null 2>&1 || :
    systemctl disable tesserafin.service >/dev/null 2>&1 || :
fi
exit 0

%postun
# Never removes /var/lib/tesserafin, /etc/tesserafin, /var/log/tesserafin or the
# tesserafin user. Package management removes what the package installed;
# everything the server produced belongs to the operator.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
fi
exit 0

%files
%license /usr/share/licenses/tesserafin-server/LICENSE
/usr/share/doc/tesserafin-server
%dir %attr(0750, tesserafin, tesserafin) /etc/tesserafin
%config(noreplace) %attr(0640, root, tesserafin) /etc/tesserafin/tesserafin.conf
/usr/bin/tesserafin
/usr/lib/tesserafin
/usr/share/tesserafin
/usr/lib/systemd/system/tesserafin.service
%dir %attr(0750, tesserafin, tesserafin) /var/lib/tesserafin
%dir %attr(0750, tesserafin, tesserafin) /var/cache/tesserafin
%dir %attr(0750, tesserafin, tesserafin) /var/log/tesserafin

%changelog
* @RPM_CHANGELOG_DATE@ Tesserafin Project <noreply@tesserafin.example> - @RPM_VERSION@-@RPM_RELEASE@
- Packaged from server commit @VCS_REF@.
