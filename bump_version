#!/usr/bin/env bash
# bump_version — move the canonical product version to a new MAJOR.MINOR.PATCH.
#
# Rewritten for #92 / [A6]. The inherited Jellyfin script hard-coded six
# `MediaBrowser.*` / `Emby.*` csproj paths, four of which no longer exist after
# the Tesserafin rename, and used unanchored `sed s|old|new|g` over whole files —
# so it silently skipped the real projects, and would have rewritten any
# unrelated occurrence of the old version string in the files it did touch.
#
# What it does now:
#   1. Validates the requested version as a MAJOR.MINOR.PATCH SemVer core, using
#      the same rule as docker/version-contract.sh.
#   2. Rewrites the AssemblyVersion/AssemblyFileVersion in SharedVersion.cs.
#   3. Rewrites <VersionPrefix> in EVERY csproj that declares one — discovered,
#      never listed — with an anchored replacement inside the element only.
#   4. Re-reads the tree through docker/version-contract.sh and verifies every
#      declaration now agrees.
#
# It does NOT commit, tag, push or publish anything. Version mutation and image
# publication are deliberately separate steps so they cannot race.
#
# Usage: ./bump_version <new_version>            e.g. ./bump_version 12.1.0
#        ./bump_version --check                  verify agreement, change nothing

set -o errexit
set -o pipefail
set -o nounset

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${REPO_ROOT}"

SHARED_VERSION_FILE="./SharedVersion.cs"
CONTRACT="./docker/version-contract.sh"

usage() {
    echo "bump_version - set the canonical product version"
    echo ""
    echo "Usage:"
    echo " $ ./bump_version <new_version>   # e.g. 12.1.0"
    echo " $ ./bump_version --check         # verify every declaration agrees"
}

# Same SemVer core rule as docker/version-contract.sh. A pre-release qualifier is
# rejected here on purpose: an assembly version is numeric-only, and pre-releases
# are expressed by the git release tag instead.
is_core_version() {
    [[ "$1" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
}

# Every csproj that actually declares a package version. Discovered so a new or
# renamed project cannot silently keep a stale version.
version_prefix_projects() {
    grep -rl --include='*.csproj' '<VersionPrefix>' . | sort
}

canonical_version() {
    sed -nE 's/^\[assembly: ?AssemblyVersion\("([^"]*)"\)\].*/\1/p' "${SHARED_VERSION_FILE}" | head -1
}

check_agreement() {
    local canonical rc=0 file declared
    canonical="$(canonical_version)"
    if ! is_core_version "${canonical}"; then
        echo "FAIL  SharedVersion.cs declares '${canonical}', which is not a MAJOR.MINOR.PATCH SemVer core"
        return 1
    fi
    echo "canonical version (SharedVersion.cs): ${canonical}"
    while IFS= read -r file; do
        declared="$(sed -nE 's;.*<VersionPrefix>([^<]*)</VersionPrefix>.*;\1;p' "${file}" | head -1)"
        if [[ "${declared}" == "${canonical}" ]]; then
            echo "  OK    ${file} (${declared})"
        else
            echo "  FAIL  ${file} declares ${declared}, expected ${canonical}"
            rc=1
        fi
    done < <(version_prefix_projects)
    if [[ -x "${CONTRACT}" ]]; then
        "${CONTRACT}" version >/dev/null || rc=1
    fi
    return "${rc}"
}

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "--check" ]]; then
    check_agreement
    exit $?
fi

new_version="$1"
if ! is_core_version "${new_version}"; then
    echo "bump_version: '${new_version}' is not a MAJOR.MINOR.PATCH SemVer core" >&2
    exit 1
fi

old_version="$(canonical_version)"
echo "old canonical version: ${old_version}"
echo "new canonical version: ${new_version}"

# Anchored on the attribute, so only the version literal inside it moves.
sed -i -E "s/(\[assembly: ?AssemblyVersion\(\")[^\"]*(\"\)\])/\1${new_version}\2/" "${SHARED_VERSION_FILE}"
sed -i -E "s/(\[assembly: ?AssemblyFileVersion\(\")[^\"]*(\"\)\])/\1${new_version}\2/" "${SHARED_VERSION_FILE}"

while IFS= read -r subproject; do
    echo "  ${subproject}"
    sed -i -E "s;(<VersionPrefix>)[^<]*(</VersionPrefix>);\1${new_version}\2;" "${subproject}"
done < <(version_prefix_projects)

echo
echo "== verifying every declaration agrees =="
check_agreement
