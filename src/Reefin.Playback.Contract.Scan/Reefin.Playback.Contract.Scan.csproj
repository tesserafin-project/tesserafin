<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Issue #75 slice 75b. This assembly is the ONLY place the raw request body is read. It is
       deliberately kept apart from Reefin.Api so its scan path can carry a strict, project-local
       ban list (BannedSymbols.txt) that would be wrong to impose on all of Reefin.Api. It references
       only the closed diagnostic vocabulary it emits into - never the model/DLNA/web world - so the
       only string it can ever touch is a server-owned member name it compares bytes against, never
       a client value it materializes. -->

  <ItemGroup>
    <ProjectReference Include="../Reefin.Playback.Contract.Diagnostics/Reefin.Playback.Contract.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #75 slice 75b: the scan-path ban list, unioned with the repo-root BannedSymbols.txt.
         RS0030 fails the BUILD (Debug analysis) if the single-pass reader ever reaches for a client
         key/value: GetString, GetComment, CopyString, ValueSpan, ValueSequence, Encoding.GetString,
         or Enum.Parse/TryParse. That is what makes "never materialize a client key or value"
         mechanical rather than a review convention. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
