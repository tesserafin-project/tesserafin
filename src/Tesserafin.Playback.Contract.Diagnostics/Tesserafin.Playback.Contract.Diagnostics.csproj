<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Issue #75 (Option 1). This assembly deliberately has NO ProjectReference at all: the
       structural closure it guarantees (every type transitively reachable from
       ContractMappingDiagnostic is an enum, a bool, an int/long, a nullable of one of those, or
       another type declared HERE) is only credible if nothing from the playback/model/DLNA world
       can be named from inside it. The comparison that produces a diagnostic lives in
       Tesserafin.Playback.Shadow (ContractMappingDiagnosticFactory), which references BOTH this
       assembly and Tesserafin.Playback.Decision - the string-handling stays on that side of the wall. -->

  <ItemGroup>
    <!-- Issue #75: project-local ban list, unioned with the repo-root BannedSymbols.txt that
         Directory.Build.props already adds. RS0030 is what makes the closure mechanical rather than
         a review convention: a future member typed string/Guid/object/dictionary/JsonElement/byte[]
         fails the build here, not just the reflection test. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
